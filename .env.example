# Copy to .env next to docker-compose.yml and edit.
# On a Synology, Container Manager reads .env from the project folder.

# Where the SQLite database lives ON THE NAS. Create this folder first.
FOOLWATCH_DATA=/volume1/docker/foolwatch/data

# LAN port for the dashboard -> http://<nas-ip>:8531
FOOLWATCH_PORT=8531

TZ=America/New_York

# Daily catch-up time (container local time). 18:30 catches the full US session.
FOOLWATCH_DAILY_AT=18:30

# Overnight archive backfill. Set FOOLWATCH_BACKFILL=0 once the queue is empty.
FOOLWATCH_BACKFILL=1
FOOLWATCH_BACKFILL_START=01:00
FOOLWATCH_BACKFILL_END=06:00
# Articles per batch. At 2 req/s a 1500-article batch takes ~12 minutes, so a
# five-hour window gets through roughly 20,000 a night — the full ~103,000
# archive lands in about four nights.
FOOLWATCH_BACKFILL_BATCH=1500

# Politeness. 6 req/s once earned a 23-hour 429 ban from fool.com; 2 is safe.
# Lower it if you see 429s in the worker log. Do not raise it.
FOOLWATCH_RPS=2
FOOLWATCH_WORKERS=4
